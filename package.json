{
  "name": "madeproof",
  "version": "0.1.0",
  "description": "Evidence-first verification layer for delegated AI work. Do not trust completion claims — verify the work.",
  "keywords": [
    "ai-agents",
    "verification",
    "evidence",
    "mcp",
    "model-context-protocol",
    "sandbox",
    "bubblewrap",
    "agent-evaluation",
    "llm",
    "verifiable-ai"
  ],
  "license": "MIT",
  "author": "Pavel Markov (castefeudal)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/castefeudal/madeproof.git"
  },
  "homepage": "https://github.com/castefeudal/madeproof#readme",
  "bugs": {
    "url": "https://github.com/castefeudal/madeproof/issues"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "files": [
    "dist/apps",
    "dist/packages",
    "dist/types",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "bin": {
    "madeproof": "dist/apps/cli/src/main.js",
    "madeproof-mcp": "dist/apps/mcp/src/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/packages/sdk/src/client.d.ts",
      "import": "./dist/packages/sdk/src/client.js"
    },
    "./mcp": {
      "types": "./dist/apps/mcp/src/protocol.d.ts",
      "import": "./dist/apps/mcp/src/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist .madeproof-data",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "dev": "npm run build && NODE_ENV=development node dist/apps/api/src/main.js",
    "start": "node dist/apps/api/src/main.js",
    "worker": "node dist/apps/runner/src/agent-main.js",
    "mcp": "node dist/apps/mcp/src/main.js",
    "cli": "node dist/apps/cli/src/main.js",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "test:security": "npm run build && node --test --test-concurrency=1 dist/tests/security/*.test.js",
    "test:e2e": "npm run build && node dist/tests/e2e/core-flow.js",
    "test:browser": "npm run build && node dist/tests/browser/ui-flow.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:browser",
    "db:migrate": "npm run build && node dist/apps/api/src/migrate.js",
    "db:seed": "npm run build && node dist/apps/api/src/seed.js",
    "test:worker": "npm run build && node --test dist/tests/integration/worker-runner.test.js",
    "test:postgres": "npm run build && node dist/tests/postgres/postgres-smoke.js",
    "test:sandbox": "npm run build && node dist/tests/sandbox/strong-sandbox-smoke.js",
    "runner": "node dist/apps/runner/src/agent-main.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
