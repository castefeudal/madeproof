# syntax=docker/dockerfile:1.7
FROM node:24.20.0-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm install --ignore-scripts
COPY . .
RUN npm run build && npm prune --omit=dev
FROM node:24.20.0-bookworm-slim AS runtime
ENV NODE_ENV=production CHROMIUM_PATH=/usr/bin/chromium
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap chromium util-linux ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /src/package.json /src/package-lock.json ./
COPY --from=build --chown=node:node /src/node_modules ./node_modules
COPY --from=build --chown=node:node /src/dist ./dist
COPY --from=build --chown=node:node /src/examples/demo-target ./examples/demo-target
USER node
ENTRYPOINT ["node","dist/apps/runner/src/agent-main.js"]
