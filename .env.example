# Required in production
NODE_ENV=development
HOST=127.0.0.1
PORT=3210
MADEPROOF_DATA_DIR=.madeproof-data
MADEPROOF_ADMIN_EMAIL=owner@localhost
MADEPROOF_ADMIN_PASSWORD=madeproof-local
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-key
PUBLIC_BASE_URL=http://127.0.0.1:3210

# Storage: sqlite is executable local/dev mode. postgres is the production target.
DATABASE_KIND=sqlite
DATABASE_URL=postgresql://madeproof:madeproof@postgres:5432/madeproof

# Optional receipt signing (Ed25519 PEM and key identifier)
RECEIPT_SIGNING_PRIVATE_KEY=
RECEIPT_SIGNING_KEY_ID=

# Optional semantic verifier providers
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# --- Runner (outbound execution boundary) ---
# Runner never receives DATABASE_URL and never mounts the Docker socket.
# It polls the control plane with a workspace-bound, one-time credential.
# Set only in the runner's own environment, never in the API environment.
MADEPROOF_RUNNER_BASE_URL=http://127.0.0.1:3210
# Register via: POST /api/v1/runners {"name":"local","version":"0.1.0","capabilities":["command"]}
# Copy the returned one-time mpr_... secret here. Consumed on first poll.
MADEPROOF_RUNNER_CREDENTIAL=
# Read-only roots the runner may execute from (path-escaped, symlink-checked)
MADEPROOF_RUNNER_ROOTS=/srv/repos/project
# Network is disabled inside Bubblewrap unless a check explicitly opts in
MADEPROOF_RUNNER_NETWORK_DISABLED=1
